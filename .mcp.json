{
  "mcpServers": {
    "claude-mem": {
      "command": "npx",
      "args": ["claude-mem", "mcp"],
      "env": {}
    },
    "websearch": {
      "command": "npx",
      "args": ["websearch-mcp"],
      "env": {
        "API_URL": "http://localhost:3001",
        "MAX_SEARCH_RESULT": "5"
      }
    }
  }
}
