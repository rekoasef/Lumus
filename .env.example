NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_PROJECT_REF=

# SMTP de Resend — usado por Supabase Auth para mandar los mails de verificación
# y recuperación de contraseña con nuestros templates custom, en vez del mail
# default de Supabase (limitado a ~2/hora, no apto para producción).
# Conseguir en: https://resend.com/api-keys (requiere dominio verificado)
RESEND_API_KEY=

# Paywall — Mercado Pago Suscripciones (producción, no sandbox)
# Access Token: mercadopago.com.ar/developers → Tus integraciones → credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
# Secret para validar la firma del webhook (mercadopago.com.ar/developers → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Casilla que recibe el aviso cuando alguien manda feedback desde la app.
# Va por variable de entorno y no hardcodeada: es un dato personal, y el
# repo ya tuvo un mail personal metido en el codigo (ver migracion 00017).
FEEDBACK_NOTIFICATION_EMAIL=tu@mail.com

# Sentry — errores de producción visibles (plan free).
# Sin DSN el SDK queda apagado, que es lo que se quiere en local: los errores
# de desarrollo se ven en la terminal, no hace falta gastarlos de la cuota.
# Conseguir en: sentry.io -> Settings -> Projects -> lumus -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Opcionales, solo para subir source maps en el build y ver stack traces del
# cliente sin minificar. Si faltan, el build funciona igual.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
